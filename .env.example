# Example env file. Copy to .env and replace all placeholder values with real secrets. Do NOT commit your actual .env file or real credentials.
# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orbit
DB_SSLMODE=verify-full
# For local development, store certs in a local ./certs directory (adjust as needed).
# In Docker/production, you might instead use /run/secrets/pg_root.crt, etc.
DB_SSLROOTCERT=./certs/pg_root.crt
DB_SSLCERT=./certs/pg_client.crt
DB_SSLKEY=./certs/pg_client.key

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRATION_HOURS=24

# MongoDB
MONGODB_URI=mongodb://mongo:27017

# Orbi
ORBI_HOST=orbit-orbi
ORBI_PORT=50042
GRPC_SERVER_PORT=50052

# Resend / Email
RESEND_API_KEY=
EMAIL_FROM="Orbit <onboarding@orbitly.qzz.io>"
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# OpenAI / Orbi
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://hkust.azure-api.net/
REDIS_ADDR=redis:6379
CALENDAR_SERVICE_ADDR=orbit-core:50052

# Google Calendar Integration (Phase 2)
# Obtain these from Google Cloud Console: https://console.cloud.google.com/
# Enable the Google Calendar API and create OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The redirect URL must be registered in Google Cloud Console
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/integration/google/callback
# The webhook URL for push notifications (must be publicly accessible HTTPS URL)
GOOGLE_WEBHOOK_URL=

