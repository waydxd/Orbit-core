# Copy to .env and fill sensitive values. This file is safe to commit.
# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orbit
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRATION_HOURS=24

# MongoDB
MONGODB_URI=mongodb://mongo:27017

# Orbi
ORBI_HOST=orbit-orbi
ORBI_PORT=50042
GRPC_SERVER_PORT=50052

# Resend / Email
RESEND_API_KEY=
EMAIL_FROM="Orbit <onboarding@orbitly.qzz.io>"
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# OpenAI / Orbi
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://hkust.azure-api.net/
REDIS_ADDR=redis:6379
CALENDAR_SERVICE_ADDR=orbit-core:50052

